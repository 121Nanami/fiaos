#!/bin/sh
# fiaOS kiosk session (runs as user "kiosk" on tty1). Restarts Chromium if it crashes.
URL="${FIAOS_URL:-http://localhost:8080}"
PROFILE="$HOME/.config/chromium"
FLAGS="--kiosk --app=$URL --noerrdialogs --disable-session-crashed-bubble --disable-infobars \
 --no-first-run --no-default-browser-check --disable-translate --disable-features=Translate,MediaRouter,OptimizationHints,AutofillServerCommunication,InterestFeedContentSuggestions \
 --disable-background-networking --disable-component-update --disable-sync --disable-default-apps --disable-extensions --disable-breakpad \
 --check-for-update-interval=31536000 --password-store=basic --autoplay-policy=no-user-gesture-required \
 --renderer-process-limit=2 --disable-pinch --overscroll-history-navigation=0 --force-device-scale-factor=${FIAOS_SCALE:-1.25} \
 --ozone-platform=wayland --enable-features=UseOzonePlatform,OverlayScrollbar --touch-events=enabled"
# wait for the local server (max ~30 s)
i=0; while [ $i -lt 60 ] && ! curl -fsS -o /dev/null "$URL/api/health"; do i=$((i+1)); sleep 0.5; done
while true; do
  # stop Chromium's "restore pages?" prompt after a crash
  [ -f "$PROFILE/Default/Preferences" ] && sed -i 's/"exited_cleanly":false/"exited_cleanly":true/; s/"exit_type":"Crashed"/"exit_type":"Normal"/' "$PROFILE/Default/Preferences"
  # -s allows VT switching (Ctrl+Alt+F2 = admin console). No idle blanking/DPMS: the screen stays on (night dimming via timers).
  # shellcheck disable=SC2086
  cage -s -- chromium $FLAGS
  sleep 2
done
